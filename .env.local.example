# ローカル開発用の環境変数（1Password 不要）。
#
# DB・Auth・Google OAuth・通知など、ローカル開発に必要な値はすべてここに平文で保存します
# （.gitignore 済みのためコミットされません）。1Password は本番デプロイと本番 DB 確認にのみ使用します。
#
# セットアップ:
#   1. cp .env.local.example .env.local
#   2. 下記の値を必要に応じて編集
#   3. npm run db:setup
#   4. npm run dev

# ローカル MySQL 接続情報（npm run db:setup のデフォルトと同じ値でよい）
DB_USER=asset_manager
DB_PASSWORD=devpassword
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asset_manager_dev

# Supabase Auth（Google認証）。開発用Supabaseプロジェクトの値を直接記載する（1Password不要）。
#   Supabaseプロジェクトの Redirect URLs に以下を登録しておくこと:
#     http://localhost:3000/auth/callback
#     （スマホ等LAN上の別端末やCloudflare Tunnel経由で確認する場合はそのURLの/auth/callbackも追加）
#   Google OAuth側のリダイレクトURIは、アプリ自身のURLではなく
#   Supabaseプロジェクトの https://<project-ref>.supabase.co/auth/v1/callback を登録する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Analytics（任意）
NEXT_PUBLIC_GA_ID=

# Signaly ログイン/登録通知（任意。未設定なら通知をスキップする）
SIGNALY_LOGIN_WEBHOOK_URL=
SIGNALY_REGISTER_WEBHOOK_URL=

# Zaim 自動取得（Issue #145）
# 初回のみ: npm install -g playwright && playwright install chromium
# その後: node scripts/zaim-login.mjs で手動ログイン状態を保存する。
ZAIM_LOGIN_URL=https://zaim.net/
ZAIM_STORAGE_STATE_PATH=.zaim/storage-state.json
# 実際に残高一覧を表示できるZaim WebのURLを指定する。
ZAIM_BALANCE_URL=
# DOMが確認できた場合は行・名称・金額のセレクタを指定する（未指定時は汎用抽出を使用）。
ZAIM_BALANCE_ROW_SELECTOR=
ZAIM_BALANCE_NAME_SELECTOR=
ZAIM_BALANCE_AMOUNT_SELECTOR=
# /home 上の証券口座リンク。未指定時は a[href*="/securities/"] を使用する。
ZAIM_SECURITIES_LINK_SELECTOR=
# 証券詳細ページの個別銘柄行・銘柄名・評価額。3つとも未指定なら汎用抽出を使用する。
ZAIM_SECURITIES_HOLDING_ROW_SELECTOR=
ZAIM_SECURITIES_HOLDING_NAME_SELECTOR=
ZAIM_SECURITIES_HOLDING_AMOUNT_SELECTOR=
# POST /api/zaim/sync の認証用シークレット。cron等から Authorization: Bearer <secret> で呼ぶ。
ZAIM_SYNC_SECRET=
# 同期対象となる Asset Manager ユーザーのメールアドレス。
ZAIM_SYNC_USER_EMAIL=
