# ローカル開発用の環境変数（1Password 不要）。
#
# DB・Auth・Google OAuth・通知など、ローカル開発に必要な値はすべてここに平文で保存します
# （.gitignore 済みのためコミットされません）。1Password は本番デプロイと本番 DB 確認にのみ使用します。
#
# セットアップ:
#   1. cp .env.local.example .env.local
#   2. 下記の値を必要に応じて編集
#   3. npm run db:setup
#   4. npm run dev

# ローカル MySQL 接続情報（npm run db:setup のデフォルトと同じ値でよい）
DB_USER=asset_manager
DB_PASSWORD=devpassword
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=asset_manager_dev

# Supabase Auth（Google認証）。開発用Supabaseプロジェクトの値を直接記載する（1Password不要）。
#   Supabaseプロジェクトの Redirect URLs に以下を登録しておくこと:
#     http://localhost:3000/auth/callback
#     （スマホ等LAN上の別端末やCloudflare Tunnel経由で確認する場合はそのURLの/auth/callbackも追加）
#   Google OAuth側のリダイレクトURIは、アプリ自身のURLではなく
#   Supabaseプロジェクトの https://<project-ref>.supabase.co/auth/v1/callback を登録する。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Analytics（任意）
NEXT_PUBLIC_GA_ID=

# Signaly ログイン/登録通知（任意。未設定なら通知をスキップする）
SIGNALY_LOGIN_WEBHOOK_URL=
SIGNALY_REGISTER_WEBHOOK_URL=

# Zaim 評価額の自動取得（Issue #145 / #191）
# 巡回・パースはAIDE（guchi-apps/aide）が日次で行い、asset-manager はその結果を
# 読み取りAPI（GET /api/money/summary）から受け取るだけになった。
# asset-manager 側にPlaywright・Zaimのログイン状態は不要。
#
# AIDEの読み取りAPI用シークレット。AIDE側の .env にある AIDE_READ_SECRET と同じ値。
# 未設定の場合、画面の「Zaimから取得」も定期実行も何もしない。
AIDE_READ_SECRET=
# AIDEの接続先。未設定なら http://127.0.0.1:3114（同じVPS上のlocalhost）。
# ローカル開発でAIDEを別ポートで起動している場合だけ指定する。
AIDE_BASE_URL=
# POST /api/zaim/sync の認証用シークレット。cron等から Authorization: Bearer <secret> で呼ぶ。
ZAIM_SYNC_SECRET=
# Zaim連携を使えるユーザーのメールアドレス（「,」区切りで複数可）。
# AIDEが持つZaimのログイン状態はサーバー上に1つしかないため、ここに設定したユーザーだけが
# 画面のZaim取得・テスト読み込みを実行できる。未設定の場合は誰も使えない。
ZAIM_SYNC_USER_EMAIL=
# 定期実行（asset-manager-zaim-sync）の失敗・保存見送りを通知するSignalyのWebhook URL。
# 任意。未設定なら通知をスキップする。
SIGNALY_ZAIM_SYNC_WEBHOOK_URL=

# --- レシートAI取込（Issue #153） ---
# レシート画像の解析に使うClaudeのAPIキー。未設定の場合、取込画面のボタンは押せない。
# 料金はAnthropicのAPI利用料（従量課金）としてかかる。
ANTHROPIC_API_KEY=
# 解析に使うモデル。未設定なら claude-opus-5。
ANTHROPIC_RECEIPT_MODEL=
# レシート画像の保存先。未設定なら <リポジトリ>/storage/receipts。
# デプロイのクリーンアップ対象外のため、デプロイしても消えない。
RECEIPT_STORAGE_DIR=
# Zaim API（OAuth 1.0a）。https://dev.zaim.net/ でアプリを登録すると発行される。
# 評価額の取得（AIDE経由）とは別系統で、支出の登録・参照だけAPIを使う。
ZAIM_CONSUMER_KEY=
ZAIM_CONSUMER_SECRET=
# npx -y tsx scripts/zaim-oauth.ts で取得して貼る。
ZAIM_ACCESS_TOKEN=
ZAIM_ACCESS_TOKEN_SECRET=
# 「反映待ち」口座のZaim account_id。
# npx -y tsx scripts/zaim-oauth.ts --accounts で一覧を出して確認する。
ZAIM_PENDING_ACCOUNT_ID=
# OAuthの認可後に戻される先。未設定なら http://localhost:9153/zaim/callback。
# Zaim開発者サイトに登録したコールバックURLと一致させる（ページ自体は無くてよい）。
ZAIM_OAUTH_CALLBACK_URL=
# スマートレシート・Amazon連携の口座id（いずれも任意）。
# 未設定なら、取り込んだ口座マスタの名前（「スマートレシート」「Amazon」を含むもの）から自動で判定する。
# 口座名を変えている・同じ語を含む口座が複数ある場合だけ設定する。
ZAIM_SMART_RECEIPT_ACCOUNT_ID=
ZAIM_AMAZON_ACCOUNT_ID=
