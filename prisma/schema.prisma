generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                   String                      @id @default(cuid())
  name                 String?
  email                String?                     @unique
  emailVerified        DateTime?
  image                String?
  hasCompletedTutorial Boolean                     @default(false)
  supabaseUserId       String?                     @unique
  categories           Category[]
  tagGroups            TagGroup[]
  assets               Asset[]
  transactions         Transaction[]
  indices              Index[]
  allocationTargets    AllocationTarget[]
  receiptImports       ReceiptImport[]
  productRules         ProductClassificationRule[]
  zaimGenres           ZaimGenre[]
  zaimAccounts         ZaimAccount[]
  genreSuggestions     ZaimGenreSuggestion[]
  copyRules            ZaimCopyRule[]
  copiedEntries        ZaimCopiedEntry[]
  gmailMessages        GmailImportedMessage[]
  dataFetchRuns        DataFetchRun[]
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  color             String
  order             Int           @default(0)
  isCash            Boolean       @default(false)
  isLiability       Boolean       @default(false)
  parentId          Int?
  isValuationTarget Boolean       @default(true)
  valuationOrder    Int           @default(0)
  valuationAlias    String?
  hidden            Boolean       @default(false)
  userId            String
  parent            Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Category[]    @relation("CategoryHierarchy")
  tags              CategoryTag[]
  assets            Asset[]
  transactions      Transaction[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([userId])
}

model TagGroup {
  id        Int           @id @default(autoincrement())
  name      String
  order     Int           @default(0)
  userId    String
  options   TagOption[]
  assetTags CategoryTag[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TagOption {
  id           Int           @id @default(autoincrement())
  name         String
  order        Int           @default(0)
  tagGroupId   Int
  tagGroup     TagGroup      @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  categoryTags CategoryTag[]

  @@index([tagGroupId])
}

model CategoryTag {
  categoryId  Int
  tagGroupId  Int
  tagOptionId Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagGroup    TagGroup  @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  tagOption   TagOption @relation(fields: [tagOptionId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagGroupId])
  @@index([tagGroupId])
  @@index([tagOptionId])
  @@index([categoryId])
}

model Asset {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  currentValue Float
  recordedAt   DateTime @default(now())
  userId       String
  category     Category @relation(fields: [categoryId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id           Int             @id @default(autoincrement())
  categoryId   Int
  type         TransactionType
  amount       Float
  transactedAt DateTime        @default(now())
  memo         String?
  realizedGain Float?
  userId       String
  category     Category        @relation(fields: [categoryId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  VALUATION
}

/// 目標の資産配分。categoryId を持つ行はカテゴリ軸、tagOptionId を持つ行はタグ軸の目標。
model AllocationTarget {
  id          Int      @id @default(autoincrement())
  userId      String
  categoryId  Int?
  tagGroupId  Int?
  tagOptionId Int?
  ratio       Float
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, tagOptionId])
  @@index([userId])
  @@index([tagGroupId])
}

model Index {
  id     Int          @id @default(autoincrement())
  name   String
  symbol String
  color  String
  order  Int          @default(0)
  hidden Boolean      @default(false)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  values IndexValue[]

  @@index([userId])
}

model IndexValue {
  id         Int      @id @default(autoincrement())
  indexId    Int
  value      Float
  recordedAt DateTime
  index      Index    @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, recordedAt])
  @@index([indexId])
}

/// レシート由来の支出。AI解析結果をZaimへ送る前にAsset Manager側で保持する（Issue #153）。
model ReceiptImport {
  id             Int                     @id @default(autoincrement())
  userId         String
  source         ReceiptSource           @default(PHOTO)
  status         ReceiptStatus           @default(ANALYZING)
  /// storage/receipts/ からの相対パス。ファイル本体はDBに入れない。
  imagePath      String?
  imageMimeType  String?
  /// 画像のSHA-256。同じ写真を二度取り込んだことを検知する。
  imageHash      String?                 @db.VarChar(64)
  storeName      String?
  purchasedAt    DateTime?
  /// Zaim連携（スマートレシート・Amazon）由来の取り込みをまとめるキー。
  /// `<由来口座id>:<日付>:<正規化した店舗名>`。撮影したレシートは null。
  sourceKey      String?                 @db.VarChar(191)
  /// 由来のZaim口座id（スマートレシート・Amazon連携口座）。撮影したレシートは null。
  sourceAccountId Int?
  /// レシート総額（円）。AI解析値を利用者が修正できる。
  totalAmount    Int?
  taxAmount      Int?
  discountAmount Int?
  /// 0.0〜1.0。低いほど確認が必要。
  confidence     Float?
  /// AI解析が失敗した場合の理由。
  analysisError  String?                 @db.Text
  memo           String?                 @db.Text
  /// Zaimへ登録した支出のうち先頭のid（商品ごとに1件登録するため代表値）。
  /// 重複登録の防止と、登録済みかどうかの判定に使う。AIDE経由のWeb版登録がidを返せない場合は null のまま。
  zaimMoneyId    BigInt?
  /// 登録先の自動連携クレジットカード口座のZaim account_id（Issue #302）。
  /// 置き換えの成立条件なので、「反映待ち」口座ではなく請求元のカードを入れる。
  zaimAccountId  Int?
  sentToZaimAt   DateTime?
  /// Zaimアプリで「置き換え」を済ませたと人が記録した時刻（Issue #302）。
  /// 置き換えの最後の1手はアプリ限定で機械から確認できないため、機械判定はしない。
  replacedAt     DateTime?
  /// Web版登録が途中で止まったときの理由。MANUAL_ACTION_REQUIRED の中身を人へ見せるために持つ。
  zaimRegisterError String?              @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          ReceiptItem[]
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, imageHash])
}

enum ReceiptSource {
  PHOTO
  SMART_RECEIPT
  AMAZON
  GMAIL
}

enum ReceiptStatus {
  ANALYZING
  REVIEW_REQUIRED
  CONFIRMED
  /// カードへ登録済み。Zaimアプリでの「置き換え」待ち（Issue #302で意味が変わった）。
  SENT_TO_ZAIM
  /// 置き換えが済んだと人が記録した状態（Issue #302）。
  REPLACED
  /// Web版登録が途中で止まり、Zaimを人が確認するまで先へ進めない状態（Issue #302）。
  MANUAL_ACTION_REQUIRED
  FAILED
}

/// レシート1行分の商品。金額は円単位の整数で持つ。
model ReceiptItem {
  id             Int                         @id @default(autoincrement())
  receiptId      Int
  order          Int                         @default(0)
  /// レシートに印字されていた文字列。
  rawName        String
  /// 照合・分類履歴のキーにする正規化済みの名称。
  normalizedName String
  quantity       Float                       @default(1)
  unitPrice      Int?
  /// 値引き適用後の支払額（円）。
  amount         Int
  /// 値引き額（円・正の数）。
  discount       Int                         @default(0)
  zaimCategoryId Int?
  zaimGenreId    Int?
  categoryName   String?
  genreName      String?
  confidence     Float?
  classifiedBy   ReceiptClassificationSource @default(AI)
  /// この商品としてZaimへ登録した支出のid。
  /// AIDE経由のWeb版登録では画面からidを取れないことがあるため、登録済みでも null になりうる。
  zaimMoneyId    BigInt?
  /// AIDEがWeb版への登録を受け付けた時刻（Issue #302）。
  /// idが取れない経路でも「この行は登録済み」と言えるようにするための印で、再送時の読み飛ばしに使う。
  zaimRegisteredAt DateTime?
  /// 取り込み元のZaim明細id（スマートレシート・Amazon由来のみ）。二重取り込みの判定に使う。
  sourceZaimMoneyId BigInt?
  receipt        ReceiptImport               @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([sourceZaimMoneyId])
}

enum ReceiptClassificationSource {
  AI
  HISTORY
  MANUAL
}

/// 「商品名 → Zaimカテゴリ/内訳」の対応履歴。AI判断より優先して適用する。
model ProductClassificationRule {
  id              Int      @id @default(autoincrement())
  userId          String
  normalizedName  String
  /// 店舗を限定しない規則は空文字で持つ（MySQLのUNIQUEはNULL同士を重複と見なさないため）。
  storeName       String   @default("")
  zaimCategoryId  Int
  zaimGenreId     Int
  categoryName    String
  genreName       String
  /// 利用者が修正して確定した回数。多いほど信頼できる。
  correctionCount Int      @default(1)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName, storeName])
  @@index([userId])
  @@index([userId, normalizedName])
}

/// Zaimのカテゴリ/内訳マスタのキャッシュ。AIに実在する内訳だけを選ばせるために持つ。
model ZaimGenre {
  id             Int      @id @default(autoincrement())
  userId         String
  zaimGenreId    Int
  zaimCategoryId Int
  name           String
  categoryName   String
  sort           Int      @default(0)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zaimGenreId])
  @@index([userId])
}

/// Zaimの口座マスタのキャッシュ。「反映待ち」口座の選択と、置き換え候補の口座名表示に使う。
model ZaimAccount {
  id            Int      @id @default(autoincrement())
  userId        String
  zaimAccountId Int
  name          String
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zaimAccountId])
  @@index([userId])
}

/// 内訳が決まっていないZaim明細への提案（Issue #271）。
/// 読み込みでは提案を作るだけで、Zaimへ書き戻すのは利用者が「反映」を押したときだけ。
model ZaimGenreSuggestion {
  id             Int                         @id @default(autoincrement())
  userId         String
  /// 提案の対象になるZaim明細id。
  zaimMoneyId    BigInt
  /// 支出日（JSTの0時で持つ）。
  date           DateTime
  amount         Int
  /// Zaimの「品目」。空の明細もあるため null を許す。
  name           String?
  /// Zaimの「お店」。
  place          String?
  fromAccountId  Int?
  accountName    String?
  /// 提案する内訳。手がかりが足りず提案できなかった行は null で残す（画面から手で選べる）。
  zaimCategoryId Int?
  zaimGenreId    Int?
  categoryName   String?
  genreName      String?
  /// 0.0〜1.0。分類履歴で決まった提案は1。
  confidence     Float                       @default(0)
  /// HISTORY（分類履歴）か AI か。MANUAL は画面で内訳を選び直した提案。
  source         ReceiptClassificationSource @default(AI)
  /// 「過去8回同じ分類」のように、人が読める根拠。
  reason         String                      @default("")
  status         ZaimSuggestionStatus        @default(PENDING)
  appliedAt      DateTime?
  detectedAt     DateTime                    @default(now())
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zaimMoneyId])
  @@index([userId])
  @@index([userId, status])
}

enum ZaimSuggestionStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// 口座間で明細を複製するルール（Issue #271）。
/// コピー元口座に入った支出を、コピー先口座へ同じ内容で登録する。
model ZaimCopyRule {
  id              Int               @id @default(autoincrement())
  userId          String
  fromAccountId   Int
  toAccountId     Int
  /// 画面表示用の口座名。マスタを取り直すと変わりうるので、判定には使わずidを正とする。
  fromAccountName String
  toAccountName   String
  /// 遡って複製する日数。
  lookbackDays    Int               @default(60)
  /// 無効なルールは手動実行でも動かさない。
  enabled         Boolean           @default(true)
  /// 取り込みのあとに自動で複製するか。false なら「いま複製する」でだけ実行する。
  autoCopy        Boolean           @default(false)
  lastRunAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  copies          ZaimCopiedEntry[]
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fromAccountId, toAccountId])
  @@index([userId])
}

/// 複製済みの明細。同じ元明細を二度登録しないために持つ（Issue #271）。
model ZaimCopiedEntry {
  id            Int          @id @default(autoincrement())
  userId        String
  ruleId        Int
  /// 複製元のZaim明細id。
  sourceMoneyId BigInt
  /// 複製先へ登録したZaim明細id。
  copiedMoneyId BigInt
  amount        Int
  date          DateTime
  copiedAt      DateTime     @default(now())
  rule          ZaimCopyRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ruleId, sourceMoneyId])
  @@index([ruleId])
  @@index([userId])
}

/// 取り込み済みのGmailメッセージ。同じメールから明細を二度作らないために持つ（Issue #271）。
/// ChatGPT/AIDEからの請求取り込み（Issue #290）が重複防止のために使い続けるため残す。
model GmailImportedMessage {
  id             Int      @id @default(autoincrement())
  userId         String
  gmailMessageId String   @db.VarChar(191)
  /// 作った取り込みのid。明細にならなかった（金額を読めなかった）メールは null。
  receiptId      Int?
  subject        String?  @db.Text
  /// ChatGPT/AIDEから受け取ったGmailスレッドのid。
  threadId       String?  @db.VarChar(191)
  /// ChatGPT/AIDEが取得した差出人。
  rawSender      String?  @db.VarChar(191)
  /// ChatGPT/AIDEが保持していた抽出元情報。再確認できるようにDBへ残す。
  sourceMetadata Json?
  /// 明細を作れなかった場合の理由。
  skipReason     String?
  importedAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMessageId])
  @@index([userId])
}

/// 定期実行（Zaim評価額の自動取得・指数の自動取得）の結果。1実行につき1行（#269）。
///
/// 結果はこれまでVPSのPM2ログと、異常時だけ飛ぶSignalyの通知にしか残っておらず、
/// 「何が反映され、何が反映されなかったか」を画面から追えなかった。
/// 表示専用の記録なので、ここが欠けても取得・保存そのものは成立する。
model DataFetchRun {
  id          Int             @id @default(autoincrement())
  userId      String
  job         DataFetchJob
  status      DataFetchStatus
  /// 何をきっかけに動いたか。デプロイ直後の1回実行を「今日の結果」と読ませないために持つ（#276）。
  trigger     DataFetchTrigger @default(SCHEDULED)
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?
  /// 何日ぶんとして取得したか（JSTの `YYYY-MM-DD`）。Zaimは巡回日で、明細の記録日とは別。
  targetDay   String?         @db.VarChar(10)
  /// 取得元の状態を一行で表したもの（例: AIDEの巡回時刻）。カードの補足に出す。
  sourceLabel String?
  /// 実行全体の結果。保存を見送った・失敗した場合はその理由。
  message     String?         @db.Text
  reflected   Int             @default(0)
  skipped     Int             @default(0)
  unmatched   Int             @default(0)
  failed      Int             @default(0)
  items       DataFetchItem[]
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, job, startedAt])
}

enum DataFetchJob {
  /// 評価額のZaim自動取得（`scripts/zaim-sync.ts`）
  ZAIM_VALUATION
  /// 指数の日次終値の取得（`scripts/fetch-index-values.ts`）
  INDEX_VALUE
}

/// 実行のきっかけ。PM2の `cron_restart` は登録時にもプロセスを1度起動するため、
/// 日中のデプロイでも定期実行と同じスクリプトが1回走る（前夜のキャッシュを読む空振り）。
/// これを最新の実行として画面に出すと「今日は1件も反映されていない」と読めてしまう。
enum DataFetchTrigger {
  /// 毎晩のcronで動いた
  SCHEDULED
  /// デプロイでPM2にプロセスが登録された直後に1回動いた
  DEPLOY
  /// 人が手で動かした
  MANUAL
}

enum DataFetchStatus {
  /// 想定どおり終わった
  SUCCESS
  /// 反映できなかった項目・失敗した項目がある
  PARTIAL
  /// 実行そのものが失敗した
  FAILED
  /// 取得元が古い・空だったため、何も保存せずに終えた
  SKIPPED
}

/// 実行の明細1件。反映できた項目も、見送った項目も同じ表に残す。
model DataFetchItem {
  id            Int              @id @default(autoincrement())
  runId         Int
  /// 画面に出す順。取得順を保つためだけに持つ。
  order         Int              @default(0)
  outcome       DataFetchOutcome
  /// 反映先の名前（カテゴリ名・指数名）。
  label         String
  /// 反映元の名前（Zaimの表示名・指数のシンボル）。
  source        String?
  /// 反映した・しようとした金額。指数は取得できた日次データの件数。
  amount        Float?
  /// 反映する前に記録されていた値。無ければ null。
  previousValue Float?
  /// その項目を「いつの評価額」として記録したか（JSTの `YYYY-MM-DD`）。項目ごとに違う。
  recordDay     String?          @db.VarChar(10)
  /// 見送り・失敗の理由コード（`ZaimSkipReason` など）。表示文言はコード側に持つ。
  reason        String?          @db.VarChar(32)
  /// 理由の補足（Zaim側の最終更新、エラーの要約など）。
  detail        String?          @db.Text
  run           DataFetchRun     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

enum DataFetchOutcome {
  /// 評価額・指数値として保存できた
  REFLECTED
  /// 取得できたが保存を見送った
  SKIPPED
  /// 取得元にあるが、対応付け先のカテゴリが無い
  UNMATCHED
  /// 取得・保存そのものが失敗した
  FAILED
}
