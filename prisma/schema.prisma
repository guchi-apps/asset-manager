generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                   String                      @id @default(cuid())
  name                 String?
  email                String?                     @unique
  emailVerified        DateTime?
  image                String?
  hasCompletedTutorial Boolean                     @default(false)
  supabaseUserId       String?                     @unique
  categories           Category[]
  tagGroups            TagGroup[]
  assets               Asset[]
  transactions         Transaction[]
  indices              Index[]
  allocationTargets    AllocationTarget[]
  receiptImports       ReceiptImport[]
  productRules         ProductClassificationRule[]
  zaimGenres           ZaimGenre[]
  zaimAccounts         ZaimAccount[]
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  color             String
  order             Int           @default(0)
  isCash            Boolean       @default(false)
  isLiability       Boolean       @default(false)
  parentId          Int?
  isValuationTarget Boolean       @default(true)
  valuationOrder    Int           @default(0)
  valuationAlias    String?
  hidden            Boolean       @default(false)
  userId            String
  parent            Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Category[]    @relation("CategoryHierarchy")
  tags              CategoryTag[]
  assets            Asset[]
  transactions      Transaction[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([userId])
}

model TagGroup {
  id        Int           @id @default(autoincrement())
  name      String
  order     Int           @default(0)
  userId    String
  options   TagOption[]
  assetTags CategoryTag[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TagOption {
  id           Int           @id @default(autoincrement())
  name         String
  order        Int           @default(0)
  tagGroupId   Int
  tagGroup     TagGroup      @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  categoryTags CategoryTag[]

  @@index([tagGroupId])
}

model CategoryTag {
  categoryId  Int
  tagGroupId  Int
  tagOptionId Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagGroup    TagGroup  @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  tagOption   TagOption @relation(fields: [tagOptionId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagGroupId])
  @@index([tagGroupId])
  @@index([tagOptionId])
  @@index([categoryId])
}

model Asset {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  currentValue Float
  recordedAt   DateTime @default(now())
  userId       String
  category     Category @relation(fields: [categoryId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id           Int             @id @default(autoincrement())
  categoryId   Int
  type         TransactionType
  amount       Float
  transactedAt DateTime        @default(now())
  memo         String?
  realizedGain Float?
  userId       String
  category     Category        @relation(fields: [categoryId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  VALUATION
}

/// 目標の資産配分。categoryId を持つ行はカテゴリ軸、tagOptionId を持つ行はタグ軸の目標。
model AllocationTarget {
  id          Int      @id @default(autoincrement())
  userId      String
  categoryId  Int?
  tagGroupId  Int?
  tagOptionId Int?
  ratio       Float
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, tagOptionId])
  @@index([userId])
  @@index([tagGroupId])
}

model Index {
  id     Int          @id @default(autoincrement())
  name   String
  symbol String
  color  String
  order  Int          @default(0)
  hidden Boolean      @default(false)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  values IndexValue[]

  @@index([userId])
}

model IndexValue {
  id         Int      @id @default(autoincrement())
  indexId    Int
  value      Float
  recordedAt DateTime
  index      Index    @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, recordedAt])
  @@index([indexId])
}

/// レシート由来の支出。AI解析結果をZaimへ送る前にAsset Manager側で保持する（Issue #153）。
model ReceiptImport {
  id             Int                     @id @default(autoincrement())
  userId         String
  source         ReceiptSource           @default(PHOTO)
  status         ReceiptStatus           @default(ANALYZING)
  /// storage/receipts/ からの相対パス。ファイル本体はDBに入れない。
  imagePath      String?
  imageMimeType  String?
  /// 画像のSHA-256。同じ写真を二度取り込んだことを検知する。
  imageHash      String?                 @db.VarChar(64)
  storeName      String?
  purchasedAt    DateTime?
  /// Zaim連携（スマートレシート・Amazon）由来の取り込みをまとめるキー。
  /// `<由来口座id>:<日付>:<正規化した店舗名>`。撮影したレシートは null。
  sourceKey      String?                 @db.VarChar(191)
  /// 由来のZaim口座id（スマートレシート・Amazon連携口座）。撮影したレシートは null。
  sourceAccountId Int?
  /// レシート総額（円）。AI解析値を利用者が修正できる。
  totalAmount    Int?
  taxAmount      Int?
  discountAmount Int?
  /// 0.0〜1.0。低いほど確認が必要。
  confidence     Float?
  /// AI解析が失敗した場合の理由。
  analysisError  String?                 @db.Text
  memo           String?                 @db.Text
  /// Zaimへ登録した支出のうち先頭のid（商品ごとに1件登録するため代表値）。
  /// 重複登録の防止と、登録済みかどうかの判定に使う。
  zaimMoneyId    Int?
  /// 登録先（「反映待ち」）口座のZaim account_id。
  zaimAccountId  Int?
  sentToZaimAt   DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          ReceiptItem[]
  candidates     ReceiptMatchCandidate[]
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, imageHash])
}

enum ReceiptSource {
  PHOTO
  SMART_RECEIPT
  AMAZON
}

enum ReceiptStatus {
  ANALYZING
  REVIEW_REQUIRED
  CONFIRMED
  SENT_TO_ZAIM
  FAILED
}

/// レシート1行分の商品。金額は円単位の整数で持つ。
model ReceiptItem {
  id             Int                         @id @default(autoincrement())
  receiptId      Int
  order          Int                         @default(0)
  /// レシートに印字されていた文字列。
  rawName        String
  /// 照合・分類履歴のキーにする正規化済みの名称。
  normalizedName String
  quantity       Float                       @default(1)
  unitPrice      Int?
  /// 値引き適用後の支払額（円）。
  amount         Int
  /// 値引き額（円・正の数）。
  discount       Int                         @default(0)
  zaimCategoryId Int?
  zaimGenreId    Int?
  categoryName   String?
  genreName      String?
  confidence     Float?
  classifiedBy   ReceiptClassificationSource @default(AI)
  /// この商品としてZaimへ登録した支出のid。
  zaimMoneyId    Int?
  /// 取り込み元のZaim明細id（スマートレシート・Amazon由来のみ）。二重取り込みの判定に使う。
  sourceZaimMoneyId Int?
  receipt        ReceiptImport               @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([sourceZaimMoneyId])
}

enum ReceiptClassificationSource {
  AI
  HISTORY
  MANUAL
}

/// 「商品名 → Zaimカテゴリ/内訳」の対応履歴。AI判断より優先して適用する。
model ProductClassificationRule {
  id              Int      @id @default(autoincrement())
  userId          String
  normalizedName  String
  /// 店舗を限定しない規則は空文字で持つ（MySQLのUNIQUEはNULL同士を重複と見なさないため）。
  storeName       String   @default("")
  zaimCategoryId  Int
  zaimGenreId     Int
  categoryName    String
  genreName       String
  /// 利用者が修正して確定した回数。多いほど信頼できる。
  correctionCount Int      @default(1)
  lastUsedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName, storeName])
  @@index([userId])
  @@index([userId, normalizedName])
}

/// Zaimのカテゴリ/内訳マスタのキャッシュ。AIに実在する内訳だけを選ばせるために持つ。
model ZaimGenre {
  id             Int      @id @default(autoincrement())
  userId         String
  zaimGenreId    Int
  zaimCategoryId Int
  name           String
  categoryName   String
  sort           Int      @default(0)
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zaimGenreId])
  @@index([userId])
}

/// Zaimの口座マスタのキャッシュ。「反映待ち」口座の選択と、置き換え候補の口座名表示に使う。
model ZaimAccount {
  id            Int      @id @default(autoincrement())
  userId        String
  zaimAccountId Int
  name          String
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, zaimAccountId])
  @@index([userId])
}

/// カード明細が反映されたときの「置き換え候補」。自動統合はせずZaim標準の置き換えに任せる。
model ReceiptMatchCandidate {
  id          Int           @id @default(autoincrement())
  receiptId   Int
  /// 候補となるカード明細のZaim money id。
  zaimMoneyId Int
  amount      Int
  date        DateTime
  accountName String?
  placeName   String?
  /// 0.0〜1.0。金額・日付・店舗名の一致度から算出する。
  score       Float
  /// 「金額一致 / 日付 2日差 / 店舗名一致」のような根拠を人が読める形で持つ。
  reason      String
  dismissed   Boolean       @default(false)
  detectedAt  DateTime      @default(now())
  receipt     ReceiptImport @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, zaimMoneyId])
  @@index([receiptId])
}
