generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  hasCompletedTutorial Boolean   @default(false)
  supabaseUserId      String?   @unique
  categories          Category[]
  tagGroups           TagGroup[]
  assets              Asset[]
  transactions        Transaction[]
  indices             Index[]
  allocationTargets   AllocationTarget[]
}

model Category {
  id                Int           @id @default(autoincrement())
  name              String
  color             String
  order             Int           @default(0)
  isCash            Boolean       @default(false)
  isLiability       Boolean       @default(false)
  parentId          Int?
  isValuationTarget Boolean       @default(true)
  valuationOrder    Int           @default(0)
  valuationAlias    String?
  hidden            Boolean       @default(false)
  userId            String
  parent            Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children          Category[]    @relation("CategoryHierarchy")
  tags              CategoryTag[]
  assets            Asset[]
  transactions      Transaction[]
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([userId])
}

model TagGroup {
  id        Int           @id @default(autoincrement())
  name      String
  order     Int           @default(0)
  userId    String
  options   TagOption[]
  assetTags CategoryTag[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TagOption {
  id           Int           @id @default(autoincrement())
  name         String
  order        Int           @default(0)
  tagGroupId   Int
  tagGroup     TagGroup      @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  categoryTags CategoryTag[]

  @@index([tagGroupId])
}

model CategoryTag {
  categoryId  Int
  tagGroupId  Int
  tagOptionId Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagGroup    TagGroup  @relation(fields: [tagGroupId], references: [id], onDelete: Cascade)
  tagOption   TagOption @relation(fields: [tagOptionId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagGroupId])
  @@index([tagGroupId])
  @@index([tagOptionId])
  @@index([categoryId])
}

model Asset {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  currentValue Float
  recordedAt   DateTime @default(now())
  userId       String
  category     Category @relation(fields: [categoryId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Transaction {
  id           Int             @id @default(autoincrement())
  categoryId   Int
  type         TransactionType
  amount       Float
  transactedAt DateTime        @default(now())
  memo         String?
  realizedGain Float?
  userId       String
  category     Category        @relation(fields: [categoryId], references: [id])
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAW
  VALUATION
}

/// 目標の資産配分。categoryId を持つ行はカテゴリ軸、tagOptionId を持つ行はタグ軸の目標。
model AllocationTarget {
  id          Int      @id @default(autoincrement())
  userId      String
  categoryId  Int?
  tagGroupId  Int?
  tagOptionId Int?
  ratio       Float
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@unique([userId, tagOptionId])
  @@index([userId])
  @@index([tagGroupId])
}

model Index {
  id       Int          @id @default(autoincrement())
  name     String
  symbol   String
  color    String
  order    Int          @default(0)
  hidden   Boolean      @default(false)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  values   IndexValue[]

  @@index([userId])
}

model IndexValue {
  id         Int      @id @default(autoincrement())
  indexId    Int
  value      Float
  recordedAt DateTime
  index      Index    @relation(fields: [indexId], references: [id], onDelete: Cascade)

  @@unique([indexId, recordedAt])
  @@index([indexId])
}
